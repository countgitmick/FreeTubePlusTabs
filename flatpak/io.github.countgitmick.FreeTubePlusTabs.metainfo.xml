<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.countgitmick.FreeTubePlusTabs</id>
  <name>FreeTube + Tabs</name>
  <summary>A private YouTube client with browser-style tabs</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <developer id="io.github.countgitmick">
    <name>countgitmick</name>
  </developer>

  <launchable type="desktop-id">io.github.countgitmick.FreeTubePlusTabs.desktop</launchable>

  <description>
    <p>FreeTube + Tabs is a fork of FreeTube that adds browser-style tabbed browsing.
       Watch YouTube privately with multiple tabs, preserving state when switching between them.</p>
    <p>Features include:</p>
    <ul>
      <li>Browser-style tabs with drag-and-drop reordering</li>
      <li>Per-tab navigation history and scroll position</li>
      <li>Idle tab suspension to save resources</li>
      <li>Ctrl+click or middle-click to open links in new tabs</li>
      <li>No tracking, no ads — uses local API or Invidious for privacy</li>
      <li>Import/export subscriptions from YouTube and other services</li>
    </ul>
  </description>

